\bMakefile\.old$
\bMANIFEST\.bak$
\bMYMETA\b
\bpm_to_blib$
\bblib\b
\b_build\b
\bBuild$
\b_eumm\b
^AmberDB-[0-9]
\.tar\.gz$
\.tgz$
\.zip$

