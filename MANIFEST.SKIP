\.bak$
\.old$
\.tmp$
\.swp$
\#.*#$
\.\#.*
\b\.vscode\b
\b\.idea\b
\bamber\.code-workspace\b
\b\.DS_Store\b
\bThumbs\.db\b
\bDesktop\.ini\b

